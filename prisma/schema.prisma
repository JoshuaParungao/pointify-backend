  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  inventoryBatches         InventoryBatch[]
  inventoryMovements       InventoryMovement[]
  itemSerials              ItemSerial[]
  quotationItems           QuotationItem[]
  saleItems                SaleItem[]
