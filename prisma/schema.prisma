model IncentiveCycle {
  id String @id @default(cuid())

  periodCode     String               @unique
  startDate      DateTime
  endDate        DateTime
  cutoffDate     DateTime
  claimOpenDate  DateTime
  claimCloseDate DateTime
  status         IncentiveCycleStatus @default(EARNING)
  closedAt       DateTime?

  // Null = legacy cycle; V2 cycles explicitly use "V2".
  engineVersion String?
  programType   IncentiveProgramType?

  branchId String?
  branch   Branch? @relation("IncentiveCycleV2Branch", fields: [branchId], references: [id], onDelete: Restrict)

  // Legacy schedule path.
  scheduleVersionId String?
  scheduleVersion   IncentiveScheduleVersion? @relation(fields: [scheduleVersionId], references: [id], onDelete: Restrict)

  // V2 per-branch/per-program schedule path.
  programScheduleVersionId String?
  programScheduleVersion   IncentiveProgramScheduleVersion? @relation("IncentiveCycleProgramSchedule", fields: [programScheduleVersionId], references: [id], onDelete: Restrict)

  closedById String?
  closedBy   User?   @relation("IncentiveCycleClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  incentives         Incentive[]
  claims             IncentiveClaim[]
  itemCycleRevisions IncentiveItemCycleRevision[] @relation("IncentiveCycleItemRevisions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate V2 branch/program periods while allowing
  // legacy rows to keep nullable V2 provenance.
  @@unique([engineVersion, branchId, programType, startDate, endDate])
  @@index([scheduleVersionId])
  @@index([programScheduleVersionId])
  @@index([branchId, programType])
  @@index([status])
  @@index([claimOpenDate, claimCloseDate])
  @@index([closedById])
}

model IncentiveItemCycleRevision {
