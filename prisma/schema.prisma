model Incentive {
  id String @id @default(cuid())

  sourceKey  String          @unique
  type       IncentiveType
  status     IncentiveStatus @default(POSTED)
  sourceCode String
  sourceDate DateTime

  basisAmount            Decimal                  @db.Decimal(12, 2)
  ratePercent            Decimal                  @db.Decimal(7, 4)
  amount                 Decimal                  @db.Decimal(12, 2)
  classificationSnapshot IncentiveClassification?

  // Null means legacy/pre-V2 incentive provenance.
  engineVersion String?
  programType   IncentiveProgramType?

  postedAt       DateTime  @default(now())
  reversedAt     DateTime?
  reversalReason String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  staffId String
  staff   User   @relation("IncentiveStaff", fields: [staffId], references: [id], onDelete: Restrict)

  // Legacy/source-specific links remain nullable for V2 item-cycle awards.
  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  serviceJobId String?
  serviceJob   ServiceJob? @relation(fields: [serviceJobId], references: [id], onDelete: Restrict)

  rateVersionId String?
  rateVersion   IncentiveRateVersion? @relation(fields: [rateVersionId], references: [id], onDelete: Restrict)

  cycleId String?
  cycle   IncentiveCycle? @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  programScheduleVersionId String?
  programScheduleVersion   IncentiveProgramScheduleVersion? @relation("IncentiveProgramSchedule", fields: [programScheduleVersionId], references: [id], onDelete: Restrict)

  programRuleVersionId String?
  programRuleVersion   IncentiveProgramRuleVersion? @relation("IncentiveProgramRule", fields: [programRuleVersionId], references: [id], onDelete: Restrict)

  accountConfigVersionId String?
  accountConfigVersion   IncentiveAccountConfigVersion? @relation("IncentiveAccountConfig", fields: [accountConfigVersionId], references: [id], onDelete: Restrict)

  itemCycleRevisionId String?
  itemCycleRevision   IncentiveItemCycleRevision? @relation("IncentiveItemRevisionAward", fields: [itemCycleRevisionId], references: [id], onDelete: Restrict)

  itemRecipientSnapshotId String?                         @unique
  itemRecipientSnapshot   IncentiveItemRecipientSnapshot? @relation("IncentiveItemRecipientAward", fields: [itemRecipientSnapshotId], references: [id], onDelete: Restrict)

  supersedesIncentiveId String?
  supersedesIncentive   Incentive?  @relation("IncentiveSupersession", fields: [supersedesIncentiveId], references: [id], onDelete: Restrict)
  supersededBy          Incentive[] @relation("IncentiveSupersession")

  claimLines IncentiveClaimLine[]

  postedById String?
  postedBy   User?   @relation("IncentivePostedBy", fields: [postedById], references: [id], onDelete: SetNull)

  reversedById String?
  reversedBy   User?   @relation("IncentiveReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, sourceDate])
  @@index([staffId, sourceDate])
  @@index([type, status])
  @@index([saleId])
  @@index([serviceJobId])
  @@index([rateVersionId])
  @@index([cycleId])
  @@index([classificationSnapshot])
  @@index([engineVersion, programType])
  @@index([programScheduleVersionId])
  @@index([programRuleVersionId])
  @@index([accountConfigVersionId])
  @@index([itemCycleRevisionId])
  @@index([supersedesIncentiveId])
  @@index([postedById])
  @@index([reversedById])
}

model IncentiveAccountConfigVersion {
