  sellingPrice2       Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice3       Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice4       Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice5       Decimal  @default(0) @db.Decimal(12, 2)

