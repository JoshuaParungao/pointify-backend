  @@index([categoryId])
  @@index([unitId])
  @@index([status])
  @@index([barcode])
  @@index([brand])
  @@index([itemName])
  @@index([isSerialized])
  @@index([hasWarranty])
  @@index([createdById])
  @@index([updatedById])
