  cycle   IncentiveCycle @relation("IncentiveCycleItemRevisions", fields: [cycleId], references: [id], onDelete: Restrict)

  programRuleVersionId String
  programRuleVersion   IncentiveProgramRuleVersion @relation("IncentiveItemRevisionProgramRule", fields: [programRuleVersionId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("IncentiveItemCycleRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  reversedById String?
  reversedBy   User?   @relation("IncentiveItemCycleRevisionReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  basisSnapshots     IncentiveItemBasisSnapshot[]
  recipientSnapshots IncentiveItemRecipientSnapshot[]
  incentives         Incentive[]                      @relation("IncentiveItemRevisionAward")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, revisionNumber])
  @@index([cycleId, status])
  @@index([programRuleVersionId])
  @@index([calculationFingerprint])
  @@index([createdById])
  @@index([reversedById])
}

model IncentiveItemBasisSnapshot {
  id String @id @default(cuid())

  revisionId String
  revision   IncentiveItemCycleRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  saleId String
  sale   Sale   @relation("IncentiveItemBasisSale", fields: [saleId], references: [id], onDelete: Restrict)

  saleItemId String
  saleItem   SaleItem @relation("IncentiveItemBasisSaleItem", fields: [saleItemId], references: [id], onDelete: Restrict)

  sourceCode              String
  sourceDate              DateTime?
  saleStatusSnapshot      String
  saleCancelledAtSnapshot DateTime?

  inclusionState  String
  inclusionReason String?
  priceTier       Int?

  grossQuantitySnapshot    Decimal @db.Decimal(12, 2)
  returnedQuantitySnapshot Decimal @db.Decimal(12, 2)
  netQuantitySnapshot      Decimal @db.Decimal(12, 2)

  baseUnitPriceSnapshot Decimal? @db.Decimal(12, 2)
  basisAmount           Decimal  @db.Decimal(12, 2)

  returnSourcesSnapshot Json

  createdAt DateTime @default(now())

  @@unique([revisionId, saleItemId])
  @@index([revisionId])
  @@index([saleId])
  @@index([saleItemId])
  @@index([inclusionState])
}

model IncentiveItemRecipientSnapshot {
  id String @id @default(cuid())

  revisionId String
  revision   IncentiveItemCycleRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  staffId String
  staff   User   @relation("IncentiveItemRecipientSnapshotStaff", fields: [staffId], references: [id], onDelete: Restrict)

  branchIdSnapshot       String
  roleSnapshot           String
  classificationSnapshot IncentiveClassification
  enabledSnapshot        Boolean

  ratePercentSnapshot Decimal? @db.Decimal(7, 4)
  amountSnapshot      Decimal  @db.Decimal(12, 2)

  accountConfigVersionId String?
  accountConfigVersion   IncentiveAccountConfigVersion? @relation("IncentiveItemRecipientConfig", fields: [accountConfigVersionId], references: [id], onDelete: Restrict)

  incentive Incentive? @relation("IncentiveItemRecipientAward")

  createdAt DateTime @default(now())

  @@unique([revisionId, staffId])
  @@index([revisionId])
  @@index([staffId])
  @@index([branchIdSnapshot])
  @@index([accountConfigVersionId])
}

model IncentiveClaim {
  id String @id @default(cuid())

  status                 IncentiveClaimStatus     @default(UNCLAIMED)
  classificationSnapshot IncentiveClassification?
  productBasis           Decimal                  @default(0) @db.Decimal(12, 2)
  productRate            Decimal?                 @db.Decimal(7, 4)
  productIncentive       Decimal                  @default(0) @db.Decimal(12, 2)
  serviceBasis           Decimal                  @default(0) @db.Decimal(12, 2)
  serviceRate            Decimal?                 @db.Decimal(7, 4)
  serviceIncentive       Decimal                  @default(0) @db.Decimal(12, 2)
  totalIncentive         Decimal                  @default(0) @db.Decimal(12, 2)

  claimedAt       DateTime?
  approvedAt      DateTime?
  paidAt          DateTime?
  payoutReference String?
  notes           String?

  cycleId String
  cycle   IncentiveCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  staffId String
  staff   User   @relation("IncentiveClaimStaff", fields: [staffId], references: [id], onDelete: Restrict)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  claimedById String?
  claimedBy   User?   @relation("IncentiveClaimClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)

  approvedById String?
  approvedBy   User?   @relation("IncentiveClaimApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  paidById String?
  paidBy   User?   @relation("IncentiveClaimPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  lines IncentiveClaimLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, staffId])
  @@index([branchId, status])
  @@index([staffId, status])
  @@index([claimedById])
  @@index([approvedById])
  @@index([paidById])
}

model IncentiveClaimLine {
  id String @id @default(cuid())

  type                   IncentiveType
  sourceCode             String
  sourceDate             DateTime
  classificationSnapshot IncentiveClassification?
  basisAmount            Decimal                  @db.Decimal(12, 2)
  ratePercent            Decimal                  @db.Decimal(7, 4)
  amount                 Decimal                  @db.Decimal(12, 2)

  claimId String
  claim   IncentiveClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  incentiveId String
  incentive   Incentive @relation(fields: [incentiveId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([claimId, incentiveId])
  @@index([claimId])
  @@index([incentiveId])
  @@index([type])
}

enum CashBoxStatus {
  ACTIVE
  INACTIVE
}

enum CashTransactionType {
  CASH_IN
  CASH_OUT
  SALE_PAYMENT
  CREDIT_COLLECTION
  HANDOVER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  SERVICE_PAYMENT
}

enum CashTransactionStatus {
  POSTED
  CANCELLED
}

enum CashTransactionSource {
  MANUAL
  SALE
  CREDIT_COLLECTION
  SYSTEM_ADJUSTMENT
  SERVICE_JOB
}

enum CashHandoverStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model CashHandover {
  id String @id @default(cuid())

  handoverCode String
  status       CashHandoverStatus @default(PENDING)

  amount Decimal @db.Decimal(12, 2)

  remarks            String?
  cancellationReason String?

  receivedAt  DateTime?
  cancelledAt DateTime?

  cashBoxId String
  cashBox   CashBox @relation(fields: [cashBoxId], references: [id], onDelete: Restrict)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  fromUserId String?
  fromUser   User?   @relation("CashHandoverFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)

  toUserId String?
  toUser   User?   @relation("CashHandoverToUser", fields: [toUserId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("CashHandoverCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  receivedById String?
  receivedBy   User?   @relation("CashHandoverReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  cancelledById String?
  cancelledBy   User?   @relation("CashHandoverCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, handoverCode])
  @@index([cashBoxId])
  @@index([branchId])
  @@index([status])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([createdById])
  @@index([receivedById])
  @@index([cancelledById])
}

model CashCustodianAssignment {
  id String @id @default(cuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation("CashCustodianAssignedUser", fields: [userId], references: [id], onDelete: Restrict)

  assignedById String?
  assignedBy   User?   @relation("CashCustodianAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  assignedAt DateTime @default(now())

  endedAt DateTime?

  endedById String?
  endedBy   User?   @relation("CashCustodianEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  endReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([branchId, endedAt])
  @@index([userId])
  @@index([userId, endedAt])
  @@index([assignedById])
  @@index([endedById])
  @@index([assignedAt])
  @@index([endedAt])
}

model CashBox {
  id String @id @default(cuid())

  boxCode String
  name    String
  status  CashBoxStatus @default(ACTIVE)

  currentBalance Decimal @default(0) @db.Decimal(12, 2)
  remarks        String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("CashBoxCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("CashBoxUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  transactions CashTransaction[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cashHandovers CashHandover[]

  @@unique([branchId, boxCode])
  @@index([branchId])
  @@index([status])
  @@index([createdById])
  @@index([updatedById])
}

model CashTransaction {
  id String @id @default(cuid())

  transactionCode String
  type            CashTransactionType
  status          CashTransactionStatus @default(POSTED)
  source          CashTransactionSource @default(MANUAL)

  amount        Decimal @db.Decimal(12, 2)
  balanceBefore Decimal @db.Decimal(12, 2)
  balanceAfter  Decimal @db.Decimal(12, 2)

  description String
  referenceNo String?
  sourceId    String?
  sourceCode  String?

  transactionDate DateTime @default(now())

  cancelledAt        DateTime?
  cancellationReason String?

  cashBoxId String
  cashBox   CashBox @relation(fields: [cashBoxId], references: [id], onDelete: Restrict)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("CashTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  cancelledById String?
  cancelledBy   User?   @relation("CashTransactionCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, transactionCode])
  @@index([cashBoxId])
  @@index([branchId])
  @@index([type])
  @@index([status])
  @@index([source])
  @@index([transactionDate])
  @@index([createdById])
  @@index([cancelledById])
}

model CreditAccount {
  id String @id @default(cuid())

  creditCode String
  status     CreditAccountStatus @default(ACTIVE)

  sourceType                ReceivableSourceType
  provider                  ReceivableProvider
  sourceTotalAmountSnapshot Decimal              @db.Decimal(12, 2)
  providerReferenceNo       String?

  idempotencyKey         String?
  idempotencyFingerprint String?

  term      InstallmentTerm?
  termBasis Decimal?         @db.Decimal(8, 4)

  cashPromoTotalAmount    Decimal? @db.Decimal(12, 2)
  regularPriceTotalAmount Decimal? @db.Decimal(12, 2)
  downpaymentAmount       Decimal  @default(0) @db.Decimal(12, 2)

  balanceAmount    Decimal  @db.Decimal(12, 2)
  monthlyDueAmount Decimal? @db.Decimal(12, 2)
  totalCollected   Decimal  @default(0) @db.Decimal(12, 2)
  remainingBalance Decimal  @db.Decimal(12, 2)

  dueDay       Int?
  firstDueDate DateTime?
  nextDueDate  DateTime?

  paidAt             DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  remarks            String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  serviceJobId String?     @unique
  serviceJob   ServiceJob? @relation(fields: [serviceJobId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("CreditAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("CreditAccountUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  cancelledById String?
  cancelledBy   User?   @relation("CreditAccountCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  collections CreditCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, creditCode])
  @@unique([branchId, idempotencyKey])
  @@index([branchId])
  @@index([customerId])
  @@index([saleId])
  @@index([serviceJobId])
  @@index([status])
  @@index([sourceType])
  @@index([provider])
  @@index([term])
  @@index([nextDueDate])
  @@index([createdById])
  @@index([updatedById])
  @@index([cancelledById])
}

model CreditCollection {
  id String @id @default(cuid())

  collectionCode String
  status         CreditCollectionStatus @default(POSTED)

  amount          Decimal @db.Decimal(12, 2)
  previousBalance Decimal @db.Decimal(12, 2)
  newBalance      Decimal @db.Decimal(12, 2)

  paymentMethod SalePaymentMethod @default(CASH)
  referenceNo   String?
  remarks       String?
  paidAt        DateTime          @default(now())

  idempotencyKey         String?
  idempotencyFingerprint String?

  cancelledAt        DateTime?
  cancellationReason String?

  creditAccountId String
  creditAccount   CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Restrict)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  collectedById String?
  collectedBy   User?   @relation("CreditCollectionCollectedBy", fields: [collectedById], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("CreditCollectionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  cancelledById String?
  cancelledBy   User?   @relation("CreditCollectionCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, collectionCode])
  @@unique([branchId, idempotencyKey])
  @@index([creditAccountId])
  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([paymentMethod])
  @@index([paidAt])
  @@index([collectedById])
  @@index([createdById])
  @@index([cancelledById])
}
