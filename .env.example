NODE_ENV=development
PORT=5000

# Use an application-specific PostgreSQL user and database. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Generate a long, random value in the deployment secret manager.
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# Comma-separated browser origins; no wildcard is used for authenticated APIs.
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"

# Set to the verified number of reverse proxies in front of Express (Coolify is commonly 1).
TRUST_PROXY=0
